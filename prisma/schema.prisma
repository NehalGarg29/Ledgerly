// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MatchType{
  exact
  fuzzy
  ai_suggested
  manual
}

enum MatchStatus{
  auto_approved
  pending_review
  approved
  rejected
}

enum UserRole{
  admin
  analyst
  viewer
}

enum AccountType {
  asset
  liability
  equity
  revenue
  expense
}

enum PolicyRuleType {
  max_amount
  inactive_fund_or_account
  restricted_account_type
}

enum PolicySeverity {
  block
  warn
}

enum ClosePeriodStatus {
  open
  closed
}

enum IssuedCheckStatus {
  issued
  cleared
  voided
}

enum PositivePayExceptionType {
  unauthorized_check
  amount_mismatch
  duplicate_presentment
}

enum PositivePayExceptionStatus {
  pending
  paid
  returned
}

enum AnomalyType {
  round_number
  duplicate_transaction
  statistical_outlier
}

enum AnomalyStatus {
  pending
  dismissed
  confirmed
}

// A tenant/workspace. Every user belongs to exactly one company, and every
// piece of reconciliation data belongs to exactly one company. Registering
// without an invite code creates a brand-new Company (you become its admin);
// registering with a valid inviteCode joins that company instead (as viewer).
model Company {
  id         String   @id @default(uuid())
  name       String
  inviteCode String   @unique
  createdAt  DateTime @default(now())

  users                 User[]
  bankTransactions      BankTransaction[]
  glEntries             GLEntry[]
  matches               Match[]
  auditLogEntries       AuditLogEntry[]
  agentTraces           AgentTrace[]
  uploadBatches         UploadBatch[]
  matchSettings         MatchSettings?
  funds                 Fund[]
  accounts              Account[]
  policyRules           PolicyRule[]
  closePeriods          ClosePeriod[]
  issuedChecks          IssuedCheck[]
  positivePayExceptions PositivePayException[]
  anomalyFlags          AnomalyFlag[]
}

model BankTransaction {
  id           String   @id @default(uuid())
  accountId    String
  date         String
  amountCents  Int
  memo         String
  sourceFormat String
  createdAt    DateTime @default(now())

  companyId String
  company   Company  @relation(fields: [companyId], references: [id])

  uploadBatchId String?
  uploadBatch   UploadBatch? @relation(fields: [uploadBatchId], references: [id])

  matches Match[]
  agentTraces  AgentTrace[]
  clearedCheck          IssuedCheck?
  positivePayException  PositivePayException?
  anomalyFlags          AnomalyFlag[]
}

model GLEntry {
  id          String   @id @default(uuid())
  fundId      String
  accountCode String
  amountCents Int
  date        String
  description String
  source      String   @default("upload") // "upload" (from a file) or "manual" (keyed in by a reviewer)
  createdAt   DateTime @default(now())

  companyId String
  company   Company  @relation(fields: [companyId], references: [id])

  uploadBatchId String?
  uploadBatch   UploadBatch? @relation(fields: [uploadBatchId], references: [id])

  matches Match[]
}

model Match {
  id                String      @id @default(uuid())
  bankTransactionId String
  bankTransaction   BankTransaction @relation(fields: [bankTransactionId], references: [id])
  glEntryId         String?
  glEntry           GLEntry?    @relation(fields: [glEntryId], references: [id])
  matchType         MatchType
  confidenceScore   Float?
  status            MatchStatus
  reviewReason      String?
  reviewedByUserId  String?
  reviewedBy        User?       @relation(fields: [reviewedByUserId], references: [id])
  reviewedAt        DateTime?
  createdAt         DateTime    @default(now())

  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
}

model AuditLogEntry {
  id          String   @id @default(uuid())
  entityType  String
  entityId    String
  action      String
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id])
  beforeState Json?
  afterState  Json?
  timestamp   DateTime @default(now())

  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         UserRole
  createdAt    DateTime @default(now())

  companyId String
  company   Company  @relation(fields: [companyId], references: [id])

  reviewedMatches Match[]
  auditActions    AuditLogEntry[]
  closedPeriods   ClosePeriod[]
}

model AgentTrace {
  id                 String   @id @default(uuid())
  bankTransactionId  String
  bankTransaction    BankTransaction @relation(fields: [bankTransactionId], references: [id])
  toolCalls          Json
  finalAction        String
  finalReasoning     String?
  proposedGlEntryId  String?
  proposedConfidence Float?
  matchId            String?
  createdAt          DateTime @default(now())

  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
}

model UploadBatch {
  id          String   @id @default(uuid())
  source      String   // "bank" or "gl"
  filename    String
  contentHash String
  rowCount    Int
  createdAt   DateTime @default(now())

  companyId String
  company   Company  @relation(fields: [companyId], references: [id])

  bankTransactions BankTransaction[]
  glEntries        GLEntry[]

  @@unique([companyId, contentHash])
}

model MatchSettings {
  id                   String   @id @default(uuid())
  autoApproveThreshold Float    @default(0.9)
  suggestThreshold     Float    @default(0.5)
  updatedAt            DateTime @updatedAt

  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id])
}

model Fund {
  id           String   @id @default(uuid())
  code         String
  name         String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  companyId String
  company   Company  @relation(fields: [companyId], references: [id])

  parentFundId String?
  parent       Fund?    @relation("FundHierarchy", fields: [parentFundId], references: [id])
  children     Fund[]   @relation("FundHierarchy")

  @@unique([companyId, code])
}

model Account {
  id              String      @id @default(uuid())
  code            String
  name            String
  type            AccountType
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())

  companyId String
  company   Company  @relation(fields: [companyId], references: [id])

  parentAccountId String?
  parent          Account?    @relation("AccountHierarchy", fields: [parentAccountId], references: [id])
  children        Account[]   @relation("AccountHierarchy")

  @@unique([companyId, code])
}

model PolicyRule {
  id                  String         @id @default(uuid())
  name                String
  ruleType            PolicyRuleType
  severity            PolicySeverity @default(warn)
  fundCode            String?        // null = applies to every fund
  thresholdCents      Int?           // used by max_amount rules
  allowedAccountTypes AccountType[]  // used by restricted_account_type rules
  isActive            Boolean        @default(true)
  createdAt           DateTime       @default(now())

  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
}

model ClosePeriod {
  id             String            @id @default(uuid())
  period         String            // "YYYY-MM"
  status         ClosePeriodStatus @default(open)
  closedAt       DateTime?
  closedByUserId String?
  closedBy       User?             @relation(fields: [closedByUserId], references: [id])
  createdAt      DateTime          @default(now())

  companyId String
  company   Company  @relation(fields: [companyId], references: [id])

  @@unique([companyId, period])
}

model IssuedCheck {
  id          String            @id @default(uuid())
  checkNumber String
  payee       String
  amountCents Int
  issueDate   String
  accountId   String
  status      IssuedCheckStatus @default(issued)
  createdAt   DateTime          @default(now())
  voidedAt    DateTime?

  companyId String
  company   Company  @relation(fields: [companyId], references: [id])

  clearedBankTransactionId String?                @unique
  clearedBankTransaction   BankTransaction?        @relation(fields: [clearedBankTransactionId], references: [id])
  exceptions               PositivePayException[]
}

model PositivePayException {
  id                  String                     @id @default(uuid())
  bankTransactionId   String                     @unique
  bankTransaction     BankTransaction            @relation(fields: [bankTransactionId], references: [id])
  issuedCheckId       String?
  issuedCheck         IssuedCheck?               @relation(fields: [issuedCheckId], references: [id])
  exceptionType       PositivePayExceptionType
  detectedCheckNumber String?
  status              PositivePayExceptionStatus @default(pending)
  reviewReason        String?
  reviewedAt          DateTime?
  createdAt           DateTime                   @default(now())

  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
}

model AnomalyFlag {
  id                String        @id @default(uuid())
  bankTransactionId String
  bankTransaction   BankTransaction @relation(fields: [bankTransactionId], references: [id])
  anomalyType       AnomalyType
  severity          Float
  explanation       String
  status            AnomalyStatus @default(pending)
  reviewReason      String?
  reviewedAt        DateTime?
  createdAt         DateTime      @default(now())

  companyId String
  company   Company  @relation(fields: [companyId], references: [id])

  @@unique([bankTransactionId, anomalyType])
}
